{
  "name": "url-shortener",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx @biomejs/biome lint src/",
    "format": "bunx @biomejs/biome format --write src/",
    "check": "bunx @biomejs/biome check src/",
    "fix": "bun run format && bunx @biomejs/biome lint --fix src/",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.7.2",
    "@types/pino": "^7.0.5",
    "dotenv": "^17.2.3",
    "pino-pretty": "^13.1.2",
    "prisma": "^6.17.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@prisma/client": "^6.17.1",
    "hono": "^4.9.12",
    "nanoid": "^5.1.6",
    "pino": "^10.0.0",
    "rate-limiter-flexible": "^8.1.0",
    "zod": "^4.1.12"
  }
}
