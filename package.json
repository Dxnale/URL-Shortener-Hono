{
  "name": "url-shortener",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx @biomejs/biome lint src/",
    "format": "bunx @biomejs/biome format --write src/",
    "check": "bunx @biomejs/biome check src/",
    "fix": "bun run format && bunx @biomejs/biome lint --fix src/",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@types/bun": "latest",
    "@types/node": "^24.2.1",
    "@types/pino": "^7.0.5",
    "dotenv": "^17.2.1",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.13.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@hono/node-server": "^1.18.1",
    "@prisma/client": "^6.13.0",
    "hono": "^4.9.0",
    "nanoid": "^5.1.5",
    "pino": "^9.8.0",
    "rate-limiter-flexible": "^7.2.0",
    "zod": "^4.0.17"
  }
}
